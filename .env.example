# Copy to .env.local and fill in. Everything prefixed VITE_ is public — never put secrets here.

# Synqop API (synqopbackend)
VITE_API_URL=http://localhost:5000

# Supabase — Project Settings → API. Use the publishable (anon) key, never the secret key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key: the bot check on sign-up and forgot password. Leave empty locally to skip it.
# (The matching secret goes on the API as TURNSTILE_SECRET_KEY.)
VITE_TURNSTILE_SITE_KEY=
